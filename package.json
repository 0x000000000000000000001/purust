{
  "name": "purust",
  "version": "0.1.0",
  "description": "PureScript-to-Rust backend",
  "type": "module",
  "bin": {
    "purust": "bin/purust"
  },
  "scripts": {
    "build": "node tools/embed-native-runtime.mjs && spago build && spago bundle --module Main --platform node --outfile bin/purust.js --bundle-type app",
    "build:native": "node tools/build-native.mjs",
    "test:native": "node tools/test-native.mjs",
    "test:codegen": "node --test tests/codegen/*.mjs",
    "test:tast": "node --test tests/tast/*.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript": "github:0x000000000000000000001/purescript-npm",
    "spago": "1.0.3"
  }
}
