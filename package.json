{
  "name": "purust",
  "version": "0.1.0",
  "description": "PureScript-to-Rust backend",
  "type": "module",
  "bin": {
    "purust": "bin/purust.js"
  },
  "scripts": {
    "build": "spago build && spago bundle --module Main --platform node --outfile bin/purust.js --bundle-type app",
    "prepare": "npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "purs-backend-es": "^1.4.3"
  },
  "devDependencies": {
    "purescript": "github:0x000000000000000000001/purescript-npm"
  }
}
