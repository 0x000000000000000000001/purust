const appRegex = /__PURUST_APP__!\(([\s\S]*?), \[([\s\S]*?)\]\)/g;
const resolveApp = (match, fn, arg) => {
    return `(${fn}).call.clone().unwrap()(${arg})`;
};
// We need a loop to handle nested __PURUST_APP__! since they can contain other apps
let lastCode = "";
while (fullCode.match(/__PURUST_APP__!/) && fullCode !== lastCode) {
    lastCode = fullCode;
    fullCode = fullCode.replace(appRegex, resolveApp);
}

